# Copy this to .env (cp .env.example .env). Never commit .env.
# The defaults below are all you need to run the hive on your laptop.

# Which hives the queen runs, comma separated. Empty means every folder in hives/.
HIVES=kalshi
LOG_LEVEL=INFO

# Database and board (these hostnames are the Docker Compose service names)
POSTGRES_USER=hive
POSTGRES_PASSWORD=hive
POSTGRES_DB=hive
DATABASE_URL=postgresql://hive:hive@postgres:5432/hive
REDIS_URL=redis://redis:6379/0

# Discord. Leave empty locally and alerts just print in the logs.
DISCORD_WEBHOOK_URL=
# Optional: a separate webhook for trade fills (falls back to the one above)
DISCORD_WEBHOOK_TRADES=

# Kalshi DEMO only. Market data needs no key. Without a key the Trader paper trades.
KALSHI_API_BASE=https://demo-api.kalshi.co/trade-api/v2
KALSHI_KEY_ID=
# Put the key file in ./secrets/ and point here:
KALSHI_PRIVATE_KEY_PATH=/app/secrets/kalshi.pem

# Free key from https://finnhub.io for the stock feed. Empty means it idles.
FINNHUB_API_KEY=

# ---- Server only (docker compose --profile prod). Ignore these locally. ----
# DuckDNS names the server. Vercel's /api/* rewrite (dashboard/vercel.json)
# points at https://$DOMAIN, so change both if you change the subdomain.
DOMAIN=hivework.duckdns.org
DUCKDNS_SUBDOMAIN=hivework
DUCKDNS_TOKEN=
# How many daily database backups to keep
BACKUP_KEEP_DAYS=7
